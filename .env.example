# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — the token below is a credential
# that can send messages as your company.
# ---------------------------------------------------------------------------

PORT=3000

# Set to 1 to enable POST /simulate for local testing without WhatsApp.
# Leave unset (or 0) in production.
SIMULATE=1

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# You invent this string, then type the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string

# Meta for Developers > App Settings > Basic > App Secret.
# Used to verify that incoming webhooks really came from Meta.
# If left blank the signature check is SKIPPED — do not ship it that way.
WHATSAPP_APP_SECRET=

# Meta ships a new Graph version every few months. Check the current one
# before deploying rather than trusting this default.
GRAPH_VERSION=v21.0

# --- Human handover ---------------------------------------------------------
# Internal WhatsApp number (digits only, with country code, no +) that gets a
# ping whenever the bot cannot answer. Leave blank to disable notifications —
# but then check the daily report for follow-ups instead.
HANDOVER_NOTIFY_NUMBER=60123456789

# --- Reply footer -----------------------------------------------------------
REPLY_FOOTER=_Automated reply — statutory reference only, not formal advice. Reply AGENT to speak to a colleague._

# --- Database ---------------------------------------------------------------
# Leave DB_HOST blank to use a local JSON file (development only).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=payrollbuddy
